# ATOMIC MYCELIUM - API CONFIGURATION
# Fill in your keys after installation

# Cerebras (Free tier: 1M tokens/day)
# Get key: https://cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Supabase (Database)
# Get from: https://supabase.com
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Risk Management (Adjust these!)
MAX_DAILY_LOSS_PERCENT=2.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PERCENT=5.0
TAKE_PROFIT_PERCENT=10.0

# Trading Modes
PAPER_TRADING_CRYPTO=true
PAPER_TRADING_STOCKS=true
LIVE_TRADING_CRYPTO=false
LIVE_TRADING_STOCKS=false

# Markets
TRADE_US_MARKETS=true
TRADE_UK_MARKETS=false
TRADE_EU_MARKETS=false
TRADE_ASIA_MARKETS=false

# Agent Identity
AGENT_ID=mycelium_spore_001
AGENT_HOST=localhost
AGENT_PORT=8080
MAX_TOKENS=4096
TEMPERATURE=0.7
